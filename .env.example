# Copy to .env (gitignored) if you prefer env vars over curl.txt.
# Both are read; curl.txt wins if present.

# Your league's base URL. The subdomain differs by sport:
#   football.cbssports.com / baseball.cbssports.com / basketball.cbssports.com
CBS_LEAGUE_URL=https://yourleague.football.cbssports.com

# The full Cookie header from a logged-in request. See README step 2.
# This is a live credential -- never commit it.
CBS_COOKIE=

# Optional. Matching your real browser's UA is one less way to look unusual.
CBS_USER_AGENT=
